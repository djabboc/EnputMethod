<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>EnputMethod.Installer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <None Update="config.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="shortcut.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="dictionary.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="enput.seed.db"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="wordnet-phrases.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="WORDNET-ATTRIBUTION.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="enput.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="themes\*.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>
  <Target Name="BuildTsfService" BeforeTargets="CopyTsfService">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\EnputMethod.Tsf\EnputMethod.Tsf.vcxproj" Properties="Configuration=$(Configuration);Platform=x64" />
  </Target>
  <Target Name="CopyTsfService" AfterTargets="Build" DependsOnTargets="BuildTsfService">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\bin\$(Configuration)\EnputMethod.Tsf.dll" DestinationFolder="$(OutputPath)" />
  </Target>
  <Target Name="CopyOverlay" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\EnputMethod.Overlay\EnputMethod.Overlay.csproj" Properties="Configuration=$(Configuration);Platform=x64" />
    <ItemGroup>
      <OverlayFiles Include="$(MSBuildThisFileDirectory)..\EnputMethod.Overlay\bin\x64\$(Configuration)\net9.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(OverlayFiles)" DestinationFiles="@(OverlayFiles->'$(OutputPath)Overlay\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="StageInstallPayload" AfterTargets="CopyOverlay" DependsOnTargets="CopyTsfService;CopyOverlay">
    <ItemGroup>
      <PayloadStaticFiles Include="$(MSBuildThisFileDirectory)config.json" />
      <PayloadStaticFiles Include="$(MSBuildThisFileDirectory)shortcut.json" />
      <PayloadStaticFiles Include="$(MSBuildThisFileDirectory)dictionary.txt" />
      <PayloadStaticFiles Include="$(MSBuildThisFileDirectory)enput.seed.db" />
      <PayloadStaticFiles Include="$(MSBuildThisFileDirectory)wordnet-phrases.txt" />
      <PayloadStaticFiles Include="$(MSBuildThisFileDirectory)WORDNET-ATTRIBUTION.txt" />
      <PayloadStaticFiles Include="$(MSBuildThisFileDirectory)enput.ico" />
      <PayloadThemeFiles Include="$(MSBuildThisFileDirectory)themes\*.json" />
      <PayloadOverlayFiles Include="$(OutputPath)Overlay\**\*" />
    </ItemGroup>
    <Copy SourceFiles="$(OutputPath)EnputMethod.Tsf.dll" DestinationFolder="$(OutputPath)payload\" />
    <Copy SourceFiles="@(PayloadStaticFiles)" DestinationFolder="$(OutputPath)payload\Resources\" />
    <Copy SourceFiles="@(PayloadThemeFiles)" DestinationFolder="$(OutputPath)payload\Resources\themes\" />
    <Copy SourceFiles="@(PayloadOverlayFiles)" DestinationFiles="@(PayloadOverlayFiles->'$(OutputPath)payload\Overlay\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>