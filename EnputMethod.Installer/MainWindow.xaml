<Window x:Class="EnputMethod.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enput Method 安装" Width="430" Height="230"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Enput Method" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" VerticalAlignment="Center"
                   Text="安装英文联想输入法到中文输入法组。&#x0a;操作需要管理员授权。"
                   TextWrapping="Wrap" FontSize="14"/>
        <Button Grid.Row="2" Content="安装" Click="Install_Click" IsDefault="True"
                Padding="24,7" HorizontalAlignment="Right"/>
    </Grid>
</Window>
