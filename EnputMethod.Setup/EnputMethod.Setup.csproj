<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>EnputMethod.Setup.Fixed</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <Target Name="BuildTsfService" BeforeTargets="CopyTsfService">
    <MSBuild Projects="$(SolutionDir)EnputMethod.Tsf\EnputMethod.Tsf.vcxproj" Properties="Configuration=$(Configuration);Platform=$(Platform);SolutionDir=$(SolutionDir)" />
  </Target>
  <Target Name="CopyTsfService" AfterTargets="Build" DependsOnTargets="BuildTsfService">
    <Copy SourceFiles="$(SolutionDir)bin\$(Configuration)\EnputMethod.Tsf.v2.dll" DestinationFolder="$(OutputPath)" Condition="Exists('$(SolutionDir)bin\$(Configuration)\EnputMethod.Tsf.v2.dll')" />
  </Target>
</Project>
